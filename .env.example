# ============================================
# 云心伴（云端守望心理陪伴系统）
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 应用基础 ----------
NODE_ENV=development
APP_NAME=yunxinban
APP_PORT=3000
AI_SERVICE_PORT=8000
ADMIN_PORT=3001

# ---------- JWT 认证 ----------
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yunxinban
POSTGRES_USER=yunxinban
POSTGRES_PASSWORD=change-me-postgres-password

# ---------- MongoDB ----------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=yunxinban
MONGO_USER=yunxinban
MONGO_PASSWORD=change-me-mongo-password
MONGO_URI=mongodb://yunxinban:change-me-mongo-password@localhost:27017/yunxinban?authSource=admin

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ---------- AES-256 加密 ----------
ENCRYPTION_KEY=change-me-32-byte-hex-key-here
KMS_ENDPOINT=https://your-kms-endpoint
KMS_KEY_ID=your-kms-key-id

# ---------- AI 模型配置 ----------
# LLM Provider: tongyi | glm | openai
LLM_PROVIDER=tongyi

# 通义千问
TONGYI_API_KEY=your-dashscope-api-key
TONGYI_MODEL=qwen-turbo
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ChatGLM（预留）
GLM_API_URL=http://localhost:8080
GLM_MODEL=chatglm3-6b

# ---------- AI 服务配置 ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000
SENTIMENT_MODEL_PATH=./models/sentiment_model.onnx

# ---------- 危机预警配置 ----------
CRISIS_ALERT_COOLDOWN=300          # 同一用户预警冷却时间（秒）
CRISIS_HIGH_THRESHOLD=0.75         # 高危阈值
CRISIS_CRITICAL_THRESHOLD=0.9       # 极危阈值
EMERGENCY_HOTLINE=400-161-9995      # 心理援助热线

# ---------- 通知推送 ----------
# 微信小程序推送
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# 短信通知
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key

# ---------- 日志 ----------
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ---------- 高可用 ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
